# ==============================================================================
# GLOBAL FUELPULSE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Authentication & PostgreSQL Database (Optional / Recommended)
# ------------------------------------------------------------------------------
# To connect your Supabase project:
# 1. Create a project at https://supabase.com
# 2. Run the SQL schema from: sql/supabase_migrations.sql in the Supabase SQL Editor
# 3. Paste your project URL and keys below:
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. OpenAI API Settings (Responses API with Real-Time Web Search)
# ------------------------------------------------------------------------------
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. Google Gemini API Settings (Free-Tier Only)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# 👉 https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Fallback alias (also supported):
# AI_API_KEY=""

# Chosen free-tier model (Never use paid models or billing-enabled features):
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash-lite, gemini-1.5-flash-8b
AI_MODEL="gemini-2.0-flash"

# Quota Protection Limits (~70% of Google Free Tier thresholds to avoid hard cutoffs):
# Google Free Tier limits for Flash models: 15 RPM, 1,500 RPD
# Daily quota limit (e.g. 200 for conservative budget, or up to 1050 for 70% of 1500):
MAX_AI_CALLS_PER_DAY=200

# Per-minute quota limit (70% of 15 RPM = 10 calls/minute):
MAX_AI_CALLS_PER_MINUTE=10

# Per-User Session Abuse Protections:
# Strict 3 free questions per user per rolling 24-hour window
DAILY_FREE_QUESTIONS_LIMIT=3
SESSION_MAX_QUESTIONS_PER_HOUR=15
SESSION_COOLDOWN_SECONDS=3.0
MAX_QUESTION_LENGTH=500

# ------------------------------------------------------------------------------
# 4. Local Database Settings (Dual-Engine: MySQL or SQLite fallback)
# ------------------------------------------------------------------------------
# If Supabase is not configured, the platform automatically falls back
# to zero-config SQLite (fuelx_local.db) or local MySQL:
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="fuelx_db"
DB_USER="root"
DB_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. Application Runtime
# ------------------------------------------------------------------------------
APP_MODE="REAL"
DEBUG="False"
API_TIMEOUT_SECONDS=15
