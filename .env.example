# ==============================================================================
# GLOBAL FUELPULSE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Settings (Free-Tier Only)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# 👉 https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Fallback alias (also supported):
# AI_API_KEY=""

# Chosen free-tier model (Never use paid models or billing-enabled features):
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash-lite, gemini-1.5-flash-8b
AI_MODEL="gemini-2.0-flash"

# Quota Protection Limits (~70% of Google Free Tier thresholds to avoid hard cutoffs):
# Google Free Tier limits for Flash models: 15 RPM, 1,500 RPD
# Daily quota limit (e.g. 200 for conservative budget, or up to 1050 for 70% of 1500):
MAX_AI_CALLS_PER_DAY=200

# Per-minute quota limit (70% of 15 RPM = 10 calls/minute):
MAX_AI_CALLS_PER_MINUTE=10

# Per-User Session Abuse Protections:
SESSION_MAX_QUESTIONS_PER_HOUR=15
SESSION_COOLDOWN_SECONDS=3.0
MAX_QUESTION_LENGTH=500

# ------------------------------------------------------------------------------
# Database Settings (Dual-Engine: MySQL or SQLite fallback)
# ------------------------------------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="fuelx_db"
DB_USER="root"
DB_PASSWORD=""

# ------------------------------------------------------------------------------
# Application Runtime
# ------------------------------------------------------------------------------
APP_MODE="REAL"
DEBUG="False"
API_TIMEOUT_SECONDS=15
